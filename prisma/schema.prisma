generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  Int              @id @default(autoincrement())
  email               String           @unique
  passwordHash        String           @map("password_hash")
  name                String?
  role                UserRole         @default(USER)
  isActive            Boolean          @default(true) @map("is_active")
  lastLogin           DateTime?        @map("last_login")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  bio                 String?          @db.Text
  designation         String?
  experience          String?
  image               String?
  linkedin            String?
  nameEnglish         String?          @map("name_english")
  twitter             String?
  authorFollowers     AuthorFollower[] @relation("AuthorFollowers")
  followedAuthors     AuthorFollower[] @relation("UserFollowers")
  authoredNews        News[]           @relation("NewsAuthor")
  news                News[]
  authorNotifications Notification[]   @relation("NotificationAuthor")
  userNotifications   Notification[]   @relation("NotificationUser")
  savedArticles       SavedArticle[]

  @@map("users")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  image       String?    @map("image")
  parentId    Int?       @map("parent_id")
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  nameEnglish String?    @map("name_english")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  news        News[]

  @@index([parentId], map: "categories_parent_id_fkey")
  @@map("categories")
}

model MainAdvertisementBanner {
  id        Int      @id @default(autoincrement())
  image     String   @map("image")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("main_advertisement_banners")
}

model District {
  id           Int           @id @default(autoincrement())
  name         String
  nameEnglish  String?       @map("name_english")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  locations    Location[]
  news         News[]
  subdivisions Subdivision[]
  tehsils      Tehsil[]

  @@map("districts")
}

model Subdivision {
  id          Int        @id @default(autoincrement())
  name        String
  nameEnglish String?    @map("name_english")
  districtId  Int?       @map("district_id")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  locations   Location[]
  news        News[]
  district    District?  @relation(fields: [districtId], references: [id])
  tehsils     Tehsil[]

  @@index([districtId], map: "subdivisions_district_id_fkey")
  @@map("subdivisions")
}

model Tehsil {
  id            Int          @id @default(autoincrement())
  name          String
  nameEnglish   String?      @map("name_english")
  districtId    Int?         @map("district_id")
  subdivisionId Int?         @map("subdivision_id")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  news          News[]
  district      District?    @relation(fields: [districtId], references: [id])
  subdivision   Subdivision? @relation(fields: [subdivisionId], references: [id])

  @@index([districtId], map: "tehsils_district_id_fkey")
  @@index([subdivisionId], map: "tehsils_subdivision_id_fkey")
  @@map("tehsils")
}

model Location {
  id            Int          @id @default(autoincrement())
  name          String
  nameEnglish   String?      @map("name_english")
  districtId    Int?         @map("district_id")
  subdivisionId Int?         @map("subdivision_id")
  groupLink     String?      @map("group_link")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  district      District?    @relation(fields: [districtId], references: [id])
  subdivision   Subdivision? @relation(fields: [subdivisionId], references: [id])
  news          News[]

  @@index([districtId], map: "locations_district_id_fkey")
  @@index([subdivisionId], map: "locations_subdivision_id_fkey")
  @@map("locations")
}

model News {
  id                 Int                @id @default(autoincrement())
  newsType           String             @default("Image") @map("news_type")
  ownerType          NewsOwnerType      @default(ADMIN) @map("owner_type")
  title              String?
  slug               String?            @unique @db.VarChar(500)
  summary            String?            @db.Text
  description        String?            @db.Text
  language           String             @default("Marathi")
  featuredImage      String?            @map("featured_image")
  newsUrl            String?            @map("news_url")
  tags               String?
  sendNotification   Boolean            @default(false) @map("send_notification")
  publishedDate      DateTime?          @map("published_date")
  isActive           Boolean            @default(true) @map("is_active")
  viewCount          Int                @default(0) @map("view_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  districtId         Int?               @map("district_id")
  subdivisionId      Int?               @map("subdivision_id")
  tehsilId           Int?               @map("tehsil_id")
  galleryImage       String?            @map("gallery_image")
  categoryId         Int?
  categoryIds        String?            @map("category_ids")
  isBreakingNews     Boolean            @default(false) @map("is_breaking_news")
  isMiniTrendingNews Boolean            @default(false) @map("is_mini_trending_news")
  isTrendingNews     Boolean            @default(false) @map("is_trending_news")
  videoId            String?            @map("video_id")
  videoUrl           String?            @map("video_url")
  locationId         Int?               @map("location_id")
  userId             Int?               @map("user_id")
  authorId           Int?               @map("author_id")
  author             User?              @relation("NewsAuthor", fields: [authorId], references: [id])
  category           Category?          @relation(fields: [categoryId], references: [id])
  district           District?          @relation(fields: [districtId], references: [id])
  location           Location?          @relation(fields: [locationId], references: [id])
  subdivision        Subdivision?       @relation(fields: [subdivisionId], references: [id])
  tehsil             Tehsil?            @relation(fields: [tehsilId], references: [id])
  user               User?              @relation(fields: [userId], references: [id])
  galleryImages      NewsGalleryImage[]
  savedBy            SavedArticle[]

  @@index([userId], map: "news_user_id_fkey")
  @@index([districtId], map: "news_district_id_fkey")
  @@index([subdivisionId], map: "news_subdivision_id_fkey")
  @@index([tehsilId], map: "news_tehsil_id_fkey")
  @@index([authorId], map: "news_author_id_fkey")
  @@index([categoryId], map: "news_categoryId_fkey")
  @@index([locationId], map: "news_location_id_fkey")
  @@map("news")
}

model SavedArticle {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  newsId    Int      @map("news_id")
  createdAt DateTime @default(now()) @map("created_at")
  news      News     @relation(fields: [newsId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, newsId])
  @@index([newsId], map: "saved_articles_news_id_fkey")
  @@map("saved_articles")
}

model NewsGalleryImage {
  id        Int      @id @default(autoincrement())
  newsId    Int      @map("news_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId], map: "news_gallery_images_news_id_fkey")
  @@map("news_gallery_images")
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletters")
}

model AuthorFollower {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  author    User     @relation("AuthorFollowers", fields: [authorId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFollowers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@index([authorId], map: "author_followers_author_id_fkey")
  @@map("author_followers")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String?  @db.Text
  type      String?
  userId    Int?     @map("user_id")
  authorId  Int?     @map("author_id")
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  author    User?    @relation("NotificationAuthor", fields: [authorId], references: [id])
  user      User?    @relation("NotificationUser", fields: [userId], references: [id])

  @@index([authorId], map: "notifications_author_id_fkey")
  @@index([userId], map: "notifications_user_id_fkey")
  @@map("notifications")
}

model Setting {
  id             Int      @id @default(autoincrement())
  appName        String?
  appLogo        String?
  appDescription String?  @db.Text
  appVersion     String?
  author         String?
  contact        String?
  email          String?
  website        String?
  developedBy    String?
  privacyPolicy  String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("settings")
}

model SmtpSetting {
  id        Int      @id @default(autoincrement())
  smtpType  String?  @map("smtp_type")
  host      String?  @map("host")
  email     String?  @map("email")
  password  String?  @map("password")
  secure    String?  @map("secure")
  port      Int?     @map("port")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("smtp_settings")
}

enum UserRole {
  ADMIN
  AUTHOR
  USER
  ADMANAGER
}

enum NewsOwnerType {
  ADMIN
  REPORTER
  PENDING_REPORTER
}
